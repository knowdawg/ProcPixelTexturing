config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Kyora_Like_Texure_System"
run/main_scene="uid://doynnfxjjekoo"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameController="*res://Globals/GameController.gd"
TerrainRendering="*uid://dx0v5byhwpvn6"
TerrainServer="*uid://cius5v5ha8ei"
PixelSandbox="*uid://cpwjn4cir6bdr"
NetworkManager="*uid://2qwyn5gs186r"
ClientNetworkGlobals="*uid://dv2k1pwanp8s8"
ServerNetworkGlobals="*uid://bwvstk0btferq"
WorldManager="*uid://1s8ixjqt2rbf"
BlueprintManager="*uid://cmnidhfk4ncgn"

[debug]

settings/profiler/max_timestamp_query_elements=512

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/pixel_sandbox/plugin.cfg")

